{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Percentage of Population with Bachelors Degrees 2021",
    "width": 420,
    "height": 400,
    "background": "rgb(255, 246, 233)",
    "view": {
        "stroke": "rgb(255, 246, 233)" 
    },
    "projection": {"type": "mercator"},
    "data": {
      "url": "https://raw.githubusercontent.com/tvog0001/3179_Vis2/refs/heads/main/STE_2021_AUST_GDA2020_simplified.topojson",
      "format": {"type": "topojson", "feature": "STE_2021_AUST_GDA2020"}
    },
  
    "transform": [
      {
        "lookup": "properties.STE_NAME21",
        "from": {
          "data": {
            "url": "https://raw.githubusercontent.com/tvog0001/3179_Vis2/refs/heads/main/Population_bachelors_ByState.csv"
          },
          "key": "State",
          "fields": ["Percentage"]
        }
      }
    ],
    "layer": [
      {
        "mark": {"type": "geoshape"},
        "encoding": {
          "color": {
            "field": "Percentage",
            "type": "quantitative",
            "title": "% of population",
            "scale": {
              "type": "threshold",
              "domain": [12, 14, 16, 18],
              "range": ["#1bbc9b", "#218f76", "#206454", "#1a3d33", "#000000"]
            }
          },
          "tooltip": [
            {"field": "properties.STE_NAME21", "type": "nominal", "title": "State"},
            {"field": "Percentage", "type": "quantitative", "title": "% of Population", "format": ",.1f"}
          ]
        }
      },
      {
      "data": {
        "values": [
          {
            "longitude": 120, 
            "latitude": -11.5   
          }
        ]
      },
      "mark": {
        "type": "rect", 
        "width": 200,    
        "height": 50,    
        "fill": "#383333",
        "stroke": "#999",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    }, 
    {
      "data": {
        "values": [
          {
            "label": "Northern Territory has the lowest \n percentage of adults whose highest \n education is a Bachelor's at 11%",
            "longitude": 120, 
            "latitude": -10 
          }
        ]
      },
      "mark": {
        "type": "text", 
        "fontSize": 12, 
        "fontStyle": "italic",
        "color": "white",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
    
    },{
      "data": {
        "values": [
          {
            "longitude": 164, 
            "latitude": -35   
          }
        ]
      },
      "mark": {
        "type": "rect",
        "width": 220,    
        "height": 50,    
        "fill": "#383333",
        "stroke": "#999",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    }, 
    {
      "data": {
        "values": [
          {
            "label": "While the ACT has the Highest \n percentage of adults whose highest \n education is a bachelors degree at 20%",
            "longitude": 164, 
            "latitude": -33.5 
          }
        ]
      },
      "mark": {
        "type": "text",  
        "fontSize": 12, 
        "fontStyle": "italic",
        "color": "white",
        "lineBreak": "\n"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "label", "type": "nominal"}
      }
      }
    ]
  }